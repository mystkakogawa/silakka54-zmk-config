/*
 * Silakka54 Mac + JIS向け
 *
 * Macのキーボード種別は「JIS」推奨。
 *
 * レイヤー切替（長押しなし・1キー順送り）:
 *   右上端「層」= Base → LOWER → RAISE → Base
 * 英数 = Aの左をタップ（長押しはCtrl）
 * かな = 右親指まん中をタップ
 * CapsLock = LOWER の Ctrl位置
 *
 * RAISE 左手3段目 = 再生系・消音・音量
 * RAISE 右手全体 = テンキー
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

// Macキーボード種別=JIS のとき、意図した文字になるHID
#define JP_YEN   INT_YEN              // ¥
#define JP_PIPE  LS(INT_YEN)          // |
#define JP_AT    LEFT_BRACKET         // @
#define JP_LBRC  RIGHT_BRACKET        // [
#define JP_RBRC  BACKSLASH            // ]
#define JP_LCBR  LS(RIGHT_BRACKET)    // {
#define JP_RCBR  LS(BACKSLASH)        // }
#define JP_LPRN  LS(N8)               // (
#define JP_RPRN  LS(N9)               // )
#define JP_UNDS  LS(INT_RO)           // _
#define JP_COLN  SINGLE_QUOTE         // :
#define JP_DQUO  LS(N2)               // "
#define JP_AMPR  LS(N6)               // &
#define JP_ASTR  LS(SINGLE_QUOTE)     // *
#define JP_PLUS  LS(SEMICOLON)        // +
#define JP_CIRC  EQUAL                // ^
#define JP_TILD  LS(N0)               // ~
#define JP_EQL   LS(MINUS)            // =
#define JP_KANA  LANGUAGE_1
#define JP_EISU  LANGUAGE_2

/ {
    macros {
        ss_full: ss_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N3>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        ss_area: ss_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        ss_bar: ss_bar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N5>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        ss_full_clip: ss_full_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N3>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LGUI>;
        };
        ss_area_clip: ss_area_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LGUI>;
        };
        ss_win: ss_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LSHFT &kp LGUI>,
                <&macro_tap &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base
        // 右上=層サイクルへLOWER / A左=英数(タップ)・Ctrl(長押し) / 右親指まん中=かな
        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &to LOWER
&kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T                     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
&mt LCTRL JP_EISU &kp A &kp S &kp D &kp F &kp G                      &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp JP_COLN
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B  &none        &none &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
               &kp LALT &kp LGUI &kp SPACE &none                 &none &kp ENTER &kp JP_KANA &kp BSPC
            >;
        };

        // LOWER: 記号 + クリップボードスクショ + Caps
        // 右上=層サイクルへRAISE
        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &ss_full_clip &ss_area_clip &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &trans &trans &trans &to RAISE
&kp F1         &kp F2       &kp F3       &kp F4        &kp F5        &kp F6          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&kp CAPSLOCK   &kp JP_AT    &kp JP_LBRC  &kp JP_RBRC   &kp FSLH      &kp JP_UNDS     &kp JP_YEN &kp JP_LPRN &kp JP_RPRN &kp JP_LCBR &kp JP_RCBR &kp JP_PIPE
&trans         &kp EXCL     &kp JP_DQUO  &kp HASH      &kp DLLR      &kp PRCNT &none &none &kp JP_CIRC &kp JP_AMPR &kp JP_ASTR &kp JP_UNDS &kp JP_PLUS &kp JP_TILD
               &trans       &trans       &trans        &none                     &none &trans &kp JP_KANA &trans
            >;
        };

        // RAISE:
        // 左手数字2〜5 = スクショ
        // 左手Q列 = 輝度・Mission等（旧F1〜F6）
        // 左手3段目 = 前へ/再生/次へ/消音/音量-/音量+
        // 左手下段 = 編集 + 矢印
        // 右手 = テンキー
        // 右上=層サイクルでBaseへ戻る
        raise_layer {
            display-name = "Raise";
            bindings = <
&trans         &trans            &ss_win      &ss_full     &ss_area     &ss_bar              &kp KP_EQUAL &kp KP_SLASH &kp KP_ASTERISK &kp KP_MINUS &kp KP_PLUS &to DEFAULT
&kp SLCK       &kp PAUSE_BREAK   &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &kp C_VOICE_COMMAND &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS    &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &kp KP_PLUS &kp KP_SLASH
&kp C_PREV     &kp C_PP          &kp C_NEXT   &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP         &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS &kp KP_ASTERISK &kp KP_ENTER
&kp LEFT       &kp DOWN          &kp UP       &kp RIGHT    &kp LG(C)    &kp LG(V) &none &none &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_N0 &kp KP_DOT &kp KP_ENTER
               &trans            &trans       &trans       &none                     &none &kp ENTER &kp JP_KANA &kp BSPC
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
        extra_3 { status = "reserved"; };
    };
};
