/*
 * Silakka54 Mac向け — わかりやすさ優先キーマップ
 *
 * 【修飾・切替（Base）】
 *   Tab / Ctrl / Shift = 左端のいつもの列
 *   Opt / Cmd / Space  = 左親指（外側→内側）※Macに近い順
 *   英数 = 右上端（短押し）/ 長押しで LOWER（記号）
 *   かな = 右親指まん中（短押し）/ 長押しで RAISE（ショートカット）
 *
 * 【記号 LOWER＝右上・英数を長押し】ホーム位置で:
 *   A=@  S=[  D=]  F=/  G=_  H=¥
 *
 * 【ショートカット RAISE＝かな長押し】印字どおりの位置で:
 *   C=コピー  V=貼り付け  Z=元に戻す  Q=スクショ
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

#define JP_YEN   INT_YEN
#define JP_AT    LEFT_BRACKET
#define JP_LBRC  RIGHT_BRACKET
#define JP_RBRC  BACKSLASH
#define JP_UNDS  LS(INT_RO)
#define JP_KANA  LANGUAGE_1
#define JP_EISU  LANGUAGE_2

/ {
    macros {
        // 範囲選択スクショ: Ctrl + Cmd + Shift + 4
        cap_macro: cap_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LGUI &kp LSHFT>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LCTRL &kp LGUI &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // --------------------------------------------------
        // Base
        // Esc 1 2 3 4 5 | 6 7 8 9 0 英数/LOWER
        // Tab Q W E R T | Y U I O P -
        // Ctl A S D F G | H J K L ; '
        // Sft Z X C V B | N M , . / Sft
        //     Opt Cmd Space | Enter かな/RAISE Bksp
        // --------------------------------------------------
        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &lt LOWER JP_EISU
&kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T                     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
&kp LCTRL      &kp A  &kp S  &kp D  &kp F  &kp G                     &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B  &none        &none &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
               &kp LALT &kp LGUI &kp SPACE &none                 &none &kp ENTER &lt RAISE JP_KANA &kp BSPC
            >;
        };

        // --------------------------------------------------
        // LOWER（右上・英数を長押し）
        // ホーム段: @ [ ] / _ ¥
        // 上段: BT / USB切替（Studio用）
        // --------------------------------------------------
        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &trans &trans &trans &trans
&kp F1         &kp F2       &kp F3       &kp F4       &kp F5       &kp F6          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&trans         &kp AT       &kp LBKT     &kp RBKT     &kp FSLH     &kp UNDER      &kp JP_YEN &kp LPAR &kp RPAR &kp LBRC &kp RBRC &kp PIPE
&trans         &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT &none &none &kp CARET &kp AMPS &kp ASTRK &kp UNDER &kp PLUS &kp JP_YEN
               &trans       &trans       &trans       &none                    &none &trans &trans &trans
            >;
        };

        // --------------------------------------------------
        // RAISE（かな長押し）
        // C=コピー V=貼付 Z=戻す Q=スクショ
        // HJKL=矢印
        // --------------------------------------------------
        raise_layer {
            display-name = "Raise";
            bindings = <
&trans         &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
&cap_macro     &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
&trans         &trans       &trans       &trans       &trans       &trans          &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&trans         &kp LG(Z)    &trans       &kp LG(C)    &kp LG(V)    &trans &none &none &trans &trans &trans &trans &trans &trans
               &trans       &trans       &trans       &none                    &none &trans &trans &trans
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
        extra_3 { status = "reserved"; };
    };
};
