/*
 * Silakka54 Mac + JIS向け（わかりやすさ優先）
 *
 * Macのキーボード種別は「JIS」推奨。
 * Base + Shift でJISの記号が出る。ボードに無い記号は LOWER。
 *
 * レイヤー切替（長押し兼用）:
 *   右上端 = 英数 / 長押し LOWER
 *   右親指まん中 = かな / 長押し RAISE
 *
 * RAISE の 3/4/5 = スクショ（ファイル保存）
 * RAISE の Q列   = MBPの F1〜F12 相当（輝度・音量など）
 * LOWER の 3/4   = スクショ（クリップボード）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

// JIS記号（Mac=JISのとき）
#define JP_YEN   INT_YEN           // ¥
#define JP_AT    LEFT_BRACKET      // @
#define JP_LBRC  RIGHT_BRACKET     // [
#define JP_RBRC  BACKSLASH         // ]
#define JP_UNDS  LS(INT_RO)        // _
#define JP_COLN  SINGLE_QUOTE      // :
#define JP_KANA  LANGUAGE_1
#define JP_EISU  LANGUAGE_2

/ {
    macros {
        // Shift+Cmd+3 全体（ファイル）
        ss_full: ss_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N3>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        // Shift+Cmd+4 範囲（ファイル）
        ss_area: ss_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        // Shift+Cmd+5 ツールバー
        ss_bar: ss_bar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N5>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        // Ctrl+Shift+Cmd+3 全体→クリップボード
        ss_full_clip: ss_full_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N3>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LGUI>;
        };
        // Ctrl+Shift+Cmd+4 範囲→クリップボード
        ss_area_clip: ss_area_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LGUI>;
        };
        // Shift+Cmd+4 のあと Space（ウインドウ撮影の入口）
        ss_win: ss_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LSHFT &kp LGUI>,
                <&macro_tap &kp SPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base: 通常JIS入力（ShiftでJIS記号）
        // 右上=英数/LOWER  右親指まん中=かな/RAISE
        // 左親指: Opt Cmd Space
        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &lt LOWER JP_EISU
&kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T                     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
&kp LCTRL      &kp A  &kp S  &kp D  &kp F  &kp G                     &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp JP_COLN
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B  &none        &none &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
               &kp LALT &kp LGUI &kp SPACE &none                 &none &kp ENTER &lt RAISE JP_KANA &kp BSPC
            >;
        };

        // LOWER: ボードに無い／取りにくい記号 + クリップボードスクショ
        // ホーム: @ [ ] / _ ¥ :
        // 数字3/4: スクショ→クリップボード
        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &ss_full_clip &ss_area_clip &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &trans &trans &trans &trans
&kp F1         &kp F2       &kp F3       &kp F4        &kp F5        &kp F6          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&trans         &kp JP_AT    &kp JP_LBRC  &kp JP_RBRC   &kp FSLH      &kp JP_UNDS     &kp JP_YEN &kp LPAR &kp RPAR &kp LBRC &kp RBRC &kp PIPE
&trans         &kp EXCL     &kp AT       &kp HASH      &kp DLLR      &kp PRCNT &none &none &kp CARET &kp AMPS &kp ASTRK &kp UNDER &kp PLUS &kp JP_YEN
               &trans       &trans       &trans        &none                     &none &trans &trans &trans
            >;
        };

        // RAISE:
        // 数字2〜5 = スクショ
        // Q列 = MBP F1〜F12 相当（左6 + 右6）
        //   F1輝度- F2輝度+ F3Mission F4Spotlight F5音声 F6Launchpad
        //   F7前へ F8再生 F9次へ F10消音 F11音量- F12音量+
        // Z戻す X切取 Cコピー V貼付 / HJKL矢印
        raise_layer {
            display-name = "Raise";
            bindings = <
&trans         &trans            &ss_win      &ss_full     &ss_area     &ss_bar              &trans &trans &trans &trans &trans &trans
&kp C_BRI_DEC  &kp C_BRI_INC     &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &kp C_VOICE_COMMAND &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS    &kp C_PREV &kp C_PP &kp C_NEXT &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP
&trans         &trans            &trans       &trans       &trans       &trans               &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&trans         &kp LG(Z)         &kp LG(X)    &kp LG(C)    &kp LG(V)    &trans &none   &none &trans &trans &trans &trans &trans &trans
               &trans            &trans       &trans       &none                     &none &trans &trans &trans
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
        extra_3 { status = "reserved"; };
    };
};
