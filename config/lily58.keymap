/*
 * Silakka54 Mac + JIS向け
 *
 * Macのキーボード種別は「JIS」推奨。
 *
 * レイヤー切替（長押しなし・1キー順送り）:
 *   右親指外側「レイヤー」= Base → LOWER → RAISE → Base
 *   右上端 = Backspace（小指）
 * 英数 = Aの左をタップ（長押しはCtrl）
 * かな = 右親指まん中をタップ
 * CapsLock = LOWER の Ctrl位置
 *
 * RAISE 左手3段目 = 再生系・消音・音量
 * RAISE 右手左4列 = テンキー（7 8 9 / / 4 5 6 * / 1 2 3 + / 0 00 . -）
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

// Macキーボード種別=JIS のとき、意図した文字になるHID
#define JP_YEN   INT_YEN              // ¥
#define JP_PIPE  LS(INT_YEN)          // |
#define JP_AT    LEFT_BRACKET         // @
#define JP_LBRC  RIGHT_BRACKET        // [
#define JP_RBRC  BACKSLASH            // ]
#define JP_LCBR  LS(RIGHT_BRACKET)    // {
#define JP_RCBR  LS(BACKSLASH)        // }
#define JP_UNDS  LS(INT_RO)           // _（ろキー相当・Baseに無い）
#define JP_COLN  SINGLE_QUOTE         // :
#define JP_CIRC  EQUAL                // ^（Baseに^キーが無い）
#define JP_GRV   LS(LEFT_BRACKET)     // `（@のShift）
#define JP_KANA  LANGUAGE_1
#define JP_EISU  LANGUAGE_2

/ {
    behaviors {
        // 英数兼用: タップ優先・判定短め（鈍さを減らす）
        mt_eisu: mt_eisu {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <120>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        ss_full: ss_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N3>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        ss_area: ss_area {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        ss_bar: ss_bar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N5>,
                <&macro_release &kp LSHFT &kp LGUI>;
        };
        ss_full_clip: ss_full_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N3>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LGUI>;
        };
        ss_area_clip: ss_area_clip {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LGUI>;
        };
        ss_win: ss_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LSHFT &kp LGUI>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LSHFT &kp LGUI>,
                <&macro_tap &kp SPACE>;
        };
        // テンキーの「00」
        kp_00: kp_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp KP_N0 &kp KP_N0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base
        // 右上=BS / 右親指外側=レイヤー→LOWER / A左=英数・Ctrl / 右親指まん中=かな
        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
&kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T                     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
&mt_eisu LCTRL JP_EISU &kp A &kp S &kp D &kp F &kp G                 &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp JP_COLN
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B  &none        &none &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
               &kp LALT &kp LGUI &kp SPACE &none                 &none &kp ENTER &kp JP_KANA &to LOWER
            >;
        };

        // LOWER: Base+Shiftで出せない記号のみ（JIS位置寄り）+ CBスクショ + Caps
        // 省いた例: !"#$%&'()=~+*?  → Baseの Shift+数字 / ; : / -
        // 右手上段端: ^ ¥ |（数字列の右端相当）
        // 右手ホーム: @ [ ] { } `（P右〜]} 相当）
        // 右手下段右: _（ろ相当・/の右）
        // 右上=BS / 右親指外側=レイヤー→RAISE
        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &ss_full_clip &ss_area_clip &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &kp JP_CIRC &kp JP_YEN &kp JP_PIPE &kp BSPC
&kp F1         &kp F2       &kp F3       &kp F4        &kp F5        &kp F6          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&kp CAPSLOCK   &trans       &trans       &trans        &trans        &trans          &kp JP_AT &kp JP_LBRC &kp JP_RBRC &kp JP_LCBR &kp JP_RCBR &kp JP_GRV
&trans         &trans       &trans       &trans        &trans        &trans &none &none &trans &trans &trans &trans &trans &kp JP_UNDS
               &trans       &trans       &trans        &none                     &none &trans &kp JP_KANA &to RAISE
            >;
        };

        // RAISE:
        // 左手数字2〜5 = スクショ
        // 左手Q列 = 輝度・Mission等（旧F1〜F6）
        // 左手3段目 = 前へ/再生/次へ/消音/音量-/音量+
        // 左手下段 = 編集 + 矢印
        // 右手左4列 = テンキー / 5列目 = 矢印↑↓←→ / 右上=BS / 親指外側=レイヤー→Base
        //   7 8 9 /  ↑
        //   4 5 6 *  ↓
        //   1 2 3 +  ←
        //   0 00 . - →
        // 左手ZXCV = 戻す・切取・コピー・貼付
        raise_layer {
            display-name = "Raise";
            bindings = <
&trans         &trans            &ss_win      &ss_full     &ss_area     &ss_bar              &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_SLASH &kp UP &kp BSPC
&kp SLCK       &kp PAUSE_BREAK   &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_AC_SEARCH &kp C_VOICE_COMMAND &kp C_AC_DESKTOP_SHOW_ALL_APPLICATIONS    &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_ASTERISK &kp DOWN &trans
&kp C_PREV     &kp C_PP          &kp C_NEXT   &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP         &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_PLUS &kp LEFT &trans
&trans         &kp LG(Z)         &kp LG(X)    &kp LG(C)    &kp LG(V)    &trans &none   &none &kp KP_N0 &kp_00 &kp KP_DOT &kp KP_MINUS &kp RIGHT &trans
               &trans            &trans       &trans       &none                     &none &kp ENTER &kp JP_KANA &to DEFAULT
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
        extra_3 { status = "reserved"; };
    };
};
