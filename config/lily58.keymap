/*
 * Silakka54（Lily58シールド）Mac + JIS向けキーマップ
 *
 * - Mac側キーボード種別は「JIS日本語」のまま使うこと
 * - 記号は JP_* 変換（OSがJISとして解釈するHIDコード）で配置
 * - Silakka54に無い4キーは &none
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// レイヤー名
#define DEFAULT 0
#define LOWER   1
#define RAISE   2

// OS設定を日本語キーボードのまま使うための変換定義
// （入力したい記号 → Mac JISが期待するHIDキーコード）
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          INT_YEN           // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(INT_YEN)       // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(INT_RO)        // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_EXCL         EXCL              // !
#define JP_HASH         HASH              // #
#define JP_DLLR         DOLLAR            // $
#define JP_PRCNT        PRCNT             // %
#define JP_RO           INT_RO            // ろ

/ {
    macros {
        // Ctrl + Cmd + Shift + 4（範囲選択スクリーンショット）
        cap_macro: cap_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LCMD &kp LSHFT>,
                <&macro_tap &kp N4>,
                <&macro_release &kp LCTRL &kp LCMD &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 【レイヤー0：通常入力】
        // ------------------------------------------------------------------------------------------------------------
        // | ESC | 1 | 2 | 3 | 4 | 5 |                 | 6 | 7 | 8 | 9 | 0 | 半角/全角 |
        // | TAB | Q | W | E | R | T |                 | Y | U | I | O | P | -        |
        // | CTRL| A | S | D | F | G |                 | H | J | K | L | ; | :        |
        // | SHFT| Z | X | C | V | B | n/a |     | n/a | N | M | , | . | / | SHIFT   |
        //       | GUI | 英数/LOWER | SPACE | n/a | | n/a | ENTER | かな/RAISE | BSPC |
        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp JP_HANZEN
&kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T                     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp MINUS
&kp LCTRL      &kp A  &kp S  &kp D  &kp F  &kp G                     &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp JP_COLON
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V  &kp B  &none        &none &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
               &kp LGUI &lt LOWER JP_EISU &kp SPACE &none      &none &kp ENTER &lt RAISE JP_KANA &kp BSPC
            >;
        };

        // 【レイヤー1：LOWER（BT / Fn / JIS記号）】
        // ------------------------------------------------------------------------------------------------------------
        // | BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |           | USB | BLE |    |    |    | CLRALL |
        // | F1    | F2  | F3  | F4  | F5  | F6  |           | F7  | F8  | F9 | F10| F11| F12    |
        // | `     | !   | @   | #   | $   | %   |           | ^   | &   | *  | (  | )  | ~      |
        // |       |     |     |     |     |     |n/a|   |n/a| _   | +   | {  | }  | |  | ¥      |
        //         |     |     |     | n/a |         | n/a |     |     |     |
        lower_layer {
            display-name = "Lower";
            bindings = <
&bt BT_CLR     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4    &out OUT_USB &out OUT_BLE &trans &trans &trans &bt BT_CLR_ALL
&kp F1         &kp F2       &kp F3       &kp F4       &kp F5       &kp F6          &kp F7      &kp F8      &kp F9 &kp F10 &kp F11 &kp F12
&kp JP_BACKQUOTE &kp JP_EXCL &kp JP_AT   &kp JP_HASH  &kp JP_DLLR  &kp JP_PRCNT    &kp JP_CARET &kp JP_AMPERSAND &kp JP_ASTERISK &kp JP_LPAREN &kp JP_RPAREN &kp JP_TILDE
&trans         &trans       &trans       &trans       &trans       &trans &none &none &kp JP_UNDERSCORE &kp JP_PLUS &kp JP_LBRACE &kp JP_RBRACE &kp JP_PIPE &kp JP_YEN
               &trans       &trans       &trans       &none                    &none &trans &trans &trans
            >;
        };

        // 【レイヤー2：RAISE（ナビ / Macショートカット / マクロ）】
        // ------------------------------------------------------------------------------------------------------------
        // |     |     |     |     |     |     |                 |     |     |     |     |     |     |
        // | 撮  |     |     |     |     |     |                 |     |     |     |     |     |     |
        // |     | CmdC| CmdV| CmdX| CmdS| CmdZ|                 | ←  | ↓  | ↑  | →  |     |     |
        // |     |     |     |     |     |     |n/a|         |n/a|     | -  | =  | [  | ]  |     |
        //       |     |     |     | n/a |             | n/a |     |     |     |
        raise_layer {
            display-name = "Raise";
            bindings = <
&trans         &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
&cap_macro     &trans       &trans       &trans       &trans       &trans          &trans &trans &trans &trans &trans &trans
&trans         &kp LG(C)    &kp LG(V)    &kp LG(X)    &kp LG(S)    &kp LG(Z)       &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&trans         &trans       &trans       &trans       &trans       &trans &none &none &trans &kp MINUS &kp JP_EQUAL &kp JP_LBRACKET &kp JP_RBRACKET &trans
               &trans       &trans       &trans       &none                    &none &trans &trans &trans
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
